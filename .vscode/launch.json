{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Attach: Agent on Microsoft cloud sandbox",
            "type": "al",
            "request": "attach",
            "environmentType": "Sandbox",
            "environmentName": "sandbox",
            "breakOnError": "All",
            "breakOnRecordWrite": "None",
            "enableSqlInformationDebugger": true,
            "enableLongRunningSqlStatements": true,
            "longRunningSqlStatementsThreshold": 500,
            "numberOfSqlStatements": 10,
            "breakOnNext": "Agent",
            "userId": "<Agent User Security ID>",
            "useMcpServerForDebugging": true
        },
        {
            "name": "Cloud Run: Run/Debug Locally",
            "type": "cloudcode.cloudrun",
            "request": "launch",
            "build": {
                "docker": {
                    "path": "cosmos-app/Dockerfile"
                }
            },
            "image": "cosmos-app",
            "service": {
                "name": "cosmos-app",
                "containerPort": 8080,
                "resources": {
                    "limits": {
                        "memory": "256Mi"
                    }
                }
            },
            "target": {
                "minikube": {}
            },
            "watch": true,
            "externalPortForward": 3003
        },
        {
            "name": "Containers: Node.js Launch",
            "type": "docker",
            "request": "launch",
            "preLaunchTask": "docker-run: debug",
            "platform": "node",
            "node": {
                "package": "${workspaceFolder}/cosmos-app/node_modules/baseline-browser-mapping/package.json",
                "localRoot": "${workspaceFolder}/cosmos-app/node_modules/baseline-browser-mapping"
            }
        }
    ]
}